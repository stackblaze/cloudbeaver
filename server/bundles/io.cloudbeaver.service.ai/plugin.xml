<?xml version="1.0" encoding="UTF-8"?>
<plugin>
    <extension point="io.cloudbeaver.service">
        <service id="ai" label="AI Service" description="AI service"
                 class="io.cloudbeaver.service.ai.gql.WebServiceBindingAI"/>
        <service id="ai.configurator" label="AI Configurator" description="AI configurator"
                 class="io.cloudbeaver.service.ai.gql.WebServiceAIConfigurator">
        </service>
    </extension>

    <!-- Stackblaze: Kubero's model proxy (active only when STACKBLAZE_LLM_URL is set). -->
    <extension point="com.dbeaver.ai.engine">
        <completionEngine id="stackblaze"
            label="Stackblaze"
            icon="platform:/plugin/org.jkiss.dbeaver.model.ai/icons/engine_openai.svg"
            class="io.cloudbeaver.service.ai.stackblaze.StackblazeAIEngine"
            properties="io.cloudbeaver.service.ai.stackblaze.StackblazeAIProperties"
            supportsFunctions="true"/>
    </extension>

    <extension point="io.cloudbeaver.object.feature.provider">
        <featureProvider id="AIFeatureProvider" class="io.cloudbeaver.service.ai.WebAIFeatureProvider"/>
    </extension>

    <extension point="org.jkiss.dbeaver.ws.event">
        <clientEvent id="cb_client_ai_function_call_confirmation"
            class="io.cloudbeaver.service.ai.model.events.WSAiFunctionCallConfirmationClientEvent"
            handler="io.cloudbeaver.service.ai.model.events.WSAiFunctionCallConfirmationHandler"/>
    </extension>
</plugin>
