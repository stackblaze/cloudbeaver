<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>
    <extension point="org.jkiss.dbeaver.dataSourceProvider">
        <datasource
                class="io.stackblaze.dbeaver.ext.mongodb.MongoDataSourceProvider"
                description="Native MongoDB / FerretDB / DocumentDB connector (Stackblaze)"
                id="mongodb"
                label="MongoDB"
                icon="icons/mongodb_icon.png"
                dialect="mongodb">

            <tree path="mongodb" label="MongoDB data source">
                <items label="Database" path="database" property="databases" icon="#database">
                    <items label="Collection" path="collection" property="collections" icon="#table">
                    </items>
                </items>
            </tree>

            <drivers managable="true">
                <driver
                        id="mongodb"
                        label="MongoDB"
                        icon="icons/mongodb_icon.png"
                        iconBig="icons/mongodb_icon_big.png"
                        category="NoSQL"
                        description="Native MongoDB / FerretDB / DocumentDB (official Java driver)"
                        categories="nosql,mongodb,ferretdb,documentdb"
                        webURL="https://www.mongodb.com/"
                        defaultPort="27017"
                        defaultDatabase=""
                        defaultUser=""
                        sampleURL="mongodb://{host}:{port}/{database}"
                        supportedConfigurationTypes="MANUAL,URL"
                        promotesSingleConnection="true">
                    <!-- EXACT version, not RELEASE: RELEASE resolves to 5.11.x, and a
                         5.11 mongodb-driver-sync sharing the driver classloader with the
                         pinned 5.6.1 mongodb-driver-core (drivers/mongodb) throws
                         NoSuchMethodError on OperationContext.<init> at connect. Every
                         mongo jar on the path must be the same version. -->
                    <file type="jar" path="maven:/org.mongodb:mongodb-driver-sync:5.6.1" bundle="!drivers.mongodb"/>
                    <file type="jar" path="drivers/mongodb" bundle="drivers.mongodb"/>
                    <property id="authSource" label="Auth database" type="string" defaultValue="admin"/>
                    <property id="authMechanism" label="Auth mechanism (scram-sha-256 | scram-sha-1 | plain)" type="string" defaultValue="scram-sha-256"/>
                    <property id="tls" label="Use TLS" type="boolean" defaultValue="false"/>
                    <property id="tlsInsecure" label="Trust any TLS certificate" type="boolean" defaultValue="false"/>
                    <parameter name="supports-references" value="false"/>
                    <parameter name="supports-indexes" value="false"/>
                    <parameter name="supports-stored-code" value="false"/>
                </driver>
            </drivers>
        </datasource>
    </extension>

    <extension point="org.jkiss.dbeaver.sqlDialect">
        <dialect
                id="mongodb"
                label="MongoDB"
                class="io.stackblaze.dbeaver.ext.mongodb.model.MongoSQLDialect"
                description="MongoDB / FerretDB (collection browsing)"
                icon="icons/mongodb_icon.png"/>
    </extension>
</plugin>
