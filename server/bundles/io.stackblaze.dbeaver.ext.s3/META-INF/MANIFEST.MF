Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Stackblaze S3/RustFS Driver
Bundle-Vendor: Stackblaze
Bundle-SymbolicName: io.stackblaze.dbeaver.ext.s3;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Bundle-Localization: OSGI-INF/l10n/bundle
Bundle-ClassPath: .,
 lib/minio.jar,
 lib/simple-xml-safe.jar,
 lib/guava.jar,
 lib/failureaccess.jar,
 lib/error_prone_annotations.jar,
 lib/j2objc-annotations.jar,
 lib/checker-qual.jar,
 lib/okhttp.jar,
 lib/okio.jar,
 lib/okio-jvm.jar,
 lib/kotlin-stdlib-jdk8.jar,
 lib/kotlin-stdlib.jar,
 lib/kotlin-stdlib-common.jar,
 lib/kotlin-stdlib-jdk7.jar,
 lib/jackson-annotations.jar,
 lib/jackson-core.jar,
 lib/jackson-databind.jar,
 lib/bcprov-jdk18on.jar,
 lib/commons-compress.jar,
 lib/commons-codec.jar,
 lib/commons-io.jar,
 lib/commons-lang3.jar,
 lib/snappy-java.jar
Require-Bundle: org.jkiss.dbeaver.model;visibility:=reexport,
 org.jkiss.dbeaver.model.nio;visibility:=reexport,
 org.jkiss.dbeaver.registry;visibility:=reexport,
 io.cloudbeaver.model
Export-Package: io.stackblaze.dbeaver.ext.s3,
 io.stackblaze.dbeaver.ext.s3.model,
 io.stackblaze.dbeaver.ext.s3.fs
Automatic-Module-Name: io.stackblaze.dbeaver.ext.s3
